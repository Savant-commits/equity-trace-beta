# Vite Environment Variables
# Copy this file to `.env.local` and fill in your actual values
# DO NOT commit `.env.local` to version control

# ── PostHog Analytics ──
# Get these values from your PostHog dashboard at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=your-posthog-api-key
VITE_PUBLIC_POSTHOG_HOST=https://your-posthog-instance.com

# Note: Variables prefixed with VITE_PUBLIC_ are exposed to your client-side code
# Variables without the prefix are only available on the server
